# Provider API keys are configured in the desktop app and stored in the
# operating-system credential store. For a headless deployment, inject them
# through the process environment instead of saving them in this file.
DASHSCOPE_REGION=us
# The alpha installer generates VOXLOG_API_TOKEN directly in macOS Keychain.
# Headless deployments should inject it through their process supervisor.
VOXLOG_ENV=home
