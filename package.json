{
  "name": "vox-agent-monorepo",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "verify:phase0": "bash ./scripts/verify_phase0.sh",
    "smoke:phase0": "bash ./scripts/smoke_phase0.sh",
    "build:alpha": "bash ./scripts/build_alpha.sh",
    "build:alpha:arm64": "BUILD_ARCH=arm64 bash ./scripts/build_alpha.sh",
    "build:alpha:intel": "BUILD_ARCH=x86_64 bash ./scripts/build_alpha.sh",
    "install:alpha": "bash ./scripts/install_alpha.sh",
    "uninstall:alpha": "bash ./scripts/uninstall_alpha.sh",
    "doctor:alpha": "bash ./scripts/doctor_alpha.sh",
    "contracts:mobile-fixtures:check": "node ./scripts/mobile_contract_fixtures.mjs --check",
    "contracts:mobile-fixtures:sync": "node ./scripts/mobile_contract_fixtures.mjs --write",
    "dev:api-ts": "npm run dev --workspace services/api-ts",
    "dev:gateway": "python -m uvicorn apps.gateway.server:app --host 127.0.0.1 --port 7903 --no-access-log",
    "dev:desktop": "cd ./apps/desktop-tauri && npm run dev",
    "test:desktop": "cargo test --manifest-path apps/desktop-tauri/src-tauri/Cargo.toml --locked",
    "dev:phase0": "bash ./scripts/dev_phase0.sh"
  },
  "workspaces": [
    "apps/desktop-tauri",
    "apps/web-console",
    "packages/contracts",
    "services/api-ts"
  ]
}
