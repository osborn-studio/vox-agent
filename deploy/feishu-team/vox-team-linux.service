[Unit]
Description=Vox team login and Feishu backup
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=vox-team
Group=vox-team
WorkingDirectory=/opt/vox-agent/current
Environment=HOME=/var/lib/vox-team
Environment=XDG_DATA_HOME=/var/lib/vox-team/.local/share
Environment=XDG_RUNTIME_DIR=/run/vox-team
Environment=PYTHON_KEYRING_BACKEND=keyring.backends.SecretService.Keyring
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=VOXAGENT_ORG_ID=vox-team
LoadCredentialEncrypted=vault-password:/etc/credstore.encrypted/vox-team-vault
LoadCredentialEncrypted=vox-app:/etc/credstore.encrypted/vox-team-app
LoadCredentialEncrypted=vox-bootstrap:/etc/credstore.encrypted/vox-team-bootstrap
ExecStart=/usr/bin/dbus-run-session -- /bin/sh /opt/vox-agent/current/deploy/feishu-team/start-linux.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
StateDirectory=vox-team
StateDirectoryMode=0700
RuntimeDirectory=vox-team
RuntimeDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
CapabilityBoundingSet=
PrivateDevices=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LimitCORE=0
MemoryMax=768M
MemorySwapMax=0
CPUQuota=50%
TasksMax=128
ReadWritePaths=/var/lib/vox-team

[Install]
WantedBy=multi-user.target
