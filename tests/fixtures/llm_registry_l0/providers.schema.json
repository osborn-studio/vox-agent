{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osbornpa.com/schemas/llm-registry/providers@1.json",
  "title": "osborn-llm-registry providers@1",
  "description": "Cross-app LLM provider registry. Consumers MUST treat unknown endpoint_types members, unknown dialect keys and unknown status values as 'unsupported/ignore', never as a fatal error. Identity bindings (id, secret.id, secret.env order, an existing endpoint's base_url) are immutable within @1; changing an address means a new endpoint key or a new provider id with the old one marked deprecated. Secrets are never stored here: secret.env lists environment-variable NAMES; platform locations are: PA = env var (first non-empty in secret.env order); macOS/iOS Keychain service 'osborn.llm' account '<secret.id>' (transition: also read service com.voxlog.scalar / com.voxlog.grouped, account aliases.vox_keychain_account); Windows Credential Manager target 'osborn.llm/<secret.id>'; Linux Secret Service attributes {service: 'osborn.llm', account: '<secret.id>'}; Android Keystore alias 'osborn.llm.<secret.id>'. URL rule: url = base_url + path with '{model}' replaced by the percent-encoded model id (JS encodeURIComponent semantics); string concatenation, never URL resolution.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "updated_at", "endpoint_types", "providers"],
  "properties": {
    "schema": { "const": "osborn-llm-registry/providers@1" },
    "updated_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "endpoint_types": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,40}$" } },
    "providers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/provider" } }
  },
  "$defs": {
    "label": { "type": "object", "additionalProperties": false, "required": ["zh", "en"], "properties": { "zh": { "type": "string", "minLength": 1, "maxLength": 60 }, "en": { "type": "string", "minLength": 1, "maxLength": 60 } } },
    "patch": {
      "description": "Typed request patch: write `value` at dot-path `path` in the top-level JSON request body (creating intermediate objects).",
      "type": "object", "additionalProperties": false, "required": ["path", "value"],
      "properties": { "path": { "type": "string", "pattern": "^[a-z_]+(\\.[a-z_]+)*$" }, "value": {} }
    },
    "dialect": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "stream_options": { "type": "boolean", "description": "Accepts chat-completions stream_options.include_usage. Absent = true." },
        "developer_role": { "type": "boolean", "description": "Accepts role: developer. Absent = false." },
        "reasoning_split": { "type": "boolean", "description": "Reasoning always on and must be split out of delta.content (MiniMax M2+). Absent = false." },
        "temperature": { "type": "boolean", "description": "Accepts non-default sampling parameters. Absent = true." },
        "thinking_disable": { "oneOf": [{ "$ref": "#/$defs/patch" }, { "type": "null" }], "description": "How to turn chain-of-thought off, as a typed patch. Absent/null = no way or not needed." }
      }
    },
    "endpoint": {
      "type": "object", "additionalProperties": false, "required": ["base_url", "chat_path", "discovery_path"],
      "properties": {
        "base_url": { "type": "string", "pattern": "^(https://[^/?#@\\s]+(/[^?#@\\s]*[^/?#@\\s])?|http://(localhost|127\\.0\\.0\\.1)(:\\d{2,5})?(/[^?#@\\s]*[^/?#@\\s])?)$" },
        "chat_path": { "type": "string", "pattern": "^/[^\\s]*$" },
        "stream_chat_path": { "type": "string", "pattern": "^/[^\\s]*$" },
        "discovery_path": { "type": "string", "pattern": "^/[^\\s]*$" },
        "dialect": { "$ref": "#/$defs/dialect" }
      }
    },
    "provider": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "label", "region", "editions", "secret", "auth", "endpoints", "default_endpoint", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,31}$" },
        "label": { "$ref": "#/$defs/label" },
        "region": { "type": "string", "enum": ["cn", "intl", "us", "local"] },
        "editions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "enum": ["cn", "global"] } },
        "aliases": { "type": "object", "description": "Application-side ids; unique within each namespace.", "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 64 } },
        "sources": { "type": "object", "description": "Upstream data-source ids (models.dev, LiteLLM); many providers may share one.", "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 64 } },
        "secret": {
          "type": "object", "additionalProperties": false, "required": ["id", "env", "required"],
          "properties": { "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,31}$" }, "env": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" } }, "required": { "type": "boolean" } }
        },
        "auth": {
          "oneOf": [
            { "type": "object", "additionalProperties": false, "required": ["type", "header", "prefix"], "properties": { "type": { "const": "api-key" }, "header": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9-]{1,63}$" }, "prefix": { "type": "string", "maxLength": 32 } } },
            { "type": "object", "additionalProperties": false, "required": ["type"], "properties": { "type": { "const": "none" } } }
          ]
        },
        "endpoints": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/endpoint" }, "propertyNames": { "pattern": "^[a-z][a-z0-9-]{2,40}$" } },
        "default_endpoint": { "type": "string" },
        "links": { "type": "object", "additionalProperties": false, "properties": { "docs": { "type": "string", "format": "uri" }, "api_key": { "type": "string", "format": "uri" }, "models": { "type": "string", "format": "uri" }, "billing": { "type": "string", "format": "uri" } } },
        "status": { "type": "string", "enum": ["active", "deprecated"] }
      }
    }
  }
}
